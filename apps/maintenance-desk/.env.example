# This platform's OWN Supabase project connection (Project Settings -> API
# in the Supabase dashboard). Used for staff_accounts, login_events, and
# nothing else — this must be Maintenance Desk's own project, separate from
# Duty Desk's and Gatehouse's.
SUPABASE_URL=https://YOUR-MAINTENANCE-DESK-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A second connection, straight to Duty Desk's Supabase project. Used
# exclusively for the maintenance_tickets and maintenance_ticket_photos
# tables — the one record genuinely shared between the two platforms (see
# src/lib/supabase.ts and src/lib/data/tickets.ts). Copy these two values
# from apps/duty-desk/.env.local — SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# there, pasted here under these names.
DUTY_DESK_SUPABASE_URL=https://YOUR-DUTY-DESK-PROJECT.supabase.co
DUTY_DESK_SUPABASE_SERVICE_ROLE_KEY=duty-desks-service-role-key

# Random 64+ character secret used to sign login session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Use a value different from every other app's SESSION_SECRET.
SESSION_SECRET=replace-with-a-long-random-string

# Same storage bucket name Duty Desk uses for maintenance ticket photos —
# the bucket lives in Duty Desk's project, reached through the
# DUTY_DESK_SUPABASE_* connection above.
MAINTENANCE_PHOTOS_BUCKET=maintenance-photos

# The live URL of the shared portal. When set, the login page shows a
# "Back to portal" link. Optional — the link just doesn't render without it.
NEXT_PUBLIC_PORTAL_URL=https://portal.vercel.app
