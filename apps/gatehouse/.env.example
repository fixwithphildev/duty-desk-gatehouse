# Supabase project connection (Project Settings -> API in the Supabase dashboard)
# This must be Gatehouse's OWN Supabase project — separate from Duty Desk's.
SUPABASE_URL=https://YOUR-GATEHOUSE-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random 64+ character secret used to sign login session tokens.
# Generate one with: openssl rand -base64 48
# Use a DIFFERENT value than Duty Desk's secret.
SESSION_SECRET=replace-with-a-long-random-string
