# Supabase project connection (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://YOUR-DUTY-DESK-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random 64+ character secret used to sign login session tokens.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# Storage bucket name for maintenance ticket photos (created during setup)
MAINTENANCE_PHOTOS_BUCKET=maintenance-photos

# Resend (resend.com) — used only for the "Email" button on Reports, to send
# a CSV copy of a report on demand. Free for up to 3,000 emails/month.
RESEND_API_KEY=your-resend-api-key
# The "from" address on sent reports. Resend's shared onboarding@resend.dev
# works immediately with no setup; switch to your own domain once verified
# in Resend if you want a branded sender address.
REPORTS_FROM_EMAIL=onboarding@resend.dev

# The live URL of the shared portal. When set, the login page shows a
# "Back to portal" link. Optional — the link just doesn't render without it.
NEXT_PUBLIC_PORTAL_URL=https://portal.vercel.app
